# Automação de Testes Web com Cypress

# Estrutura básica do projeto
# Dependências: Cypress, Cucumber

# Instalação
# Comandos para inicializar o projeto:
# 1. npm init -y
# 2. npm install cypress @cypress/cucumber-preprocessor

# Arquivo Cypress (cypress/integration/tests.feature)
# Teste automatizado baseado no Gherkin acima

Feature: Teste funcional no site Advantage Online Shopping

  Scenario: Busca de um produto
    Given I visit "https://advantageonlineshopping.com"
    When I search for "mouse"
    Then I should see products related to "mouse"

  Scenario: Adicionar produto ao carrinho
    Given I search for "mouse"
    When I add the first product to the cart
    And I navigate to the payment screen
    Then I should see the product in the cart

# Comandos Cypress (cypress/support/commands.js)

Cypress.Commands.add('searchForProduct', (product) => {
  cy.get('#searchInput').type(product);
  cy.get('#searchButton').click();
});

Cypress.Commands.add('addToCart', () => {
  cy.get('.add-to-cart-button').first().click();
});

Cypress.Commands.add('validateCart', (product) => {
  cy.get('.cart-items').should('contain', product);
});